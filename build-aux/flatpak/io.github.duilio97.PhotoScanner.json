{
    "id": "io.github.duilio97.PhotoScanner",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "photoscanner",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/cmake",
        "/share/man",
        "*.a",
        "*.la"
    ],
    "modules": [
        {
            "name": "python3-build-deps",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} --no-build-isolation meson-python pyproject-metadata"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/37/35/26a6c96ed91fa3baacd64da82f279bc282eade45003c00d99293332b45e1/meson_python-0.22.0-py3-none-any.whl",
                    "sha256": "0ce9fa40bb8bfaecccba97347063970e1a18cca2730d6e68a341dc0b73b284a4"
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/b9/8e/d883718e872abc214ba053f60f7e6edc2abd5ffbd1544beb01a9c92ddd3c/pyproject_metadata-0.12.1-py3-none-any.whl",
                    "sha256": "f7162d580a96386a8eb096da06215f981f547d1490f03055ef99e323bc2da427"
                }
            ],
            "cleanup": [
                "*"
            ]
        },
        {
            "name": "python3-numpy",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} --no-build-isolation -Csetup-args=-Dallow-noblas=true numpy"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/13/01/11703282db468b85f6f7b8c7f22d058de5970d5c7e60a3a8aaa313c3de36/numpy-2.5.3.tar.gz",
                    "sha256": "df2d5874ff183595a4ba404edd04f6bd9b5505c1d7708573f6a6c17489a67563"
                }
            ],
            "cleanup": [
                "/bin"
            ]
        },
        {
            "name": "opencv",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_LIST=core,imgproc,imgcodecs,python3",
                "-DBUILD_SHARED_LIBS=ON",
                "-DBUILD_TESTS=OFF",
                "-DBUILD_PERF_TESTS=OFF",
                "-DBUILD_EXAMPLES=OFF",
                "-DBUILD_DOCS=OFF",
                "-DBUILD_JAVA=OFF",
                "-DBUILD_opencv_apps=OFF",
                "-DBUILD_opencv_python2=OFF",
                "-DBUILD_opencv_python3=ON",
                "-DBUILD_JPEG=OFF",
                "-DBUILD_PNG=OFF",
                "-DBUILD_ZLIB=OFF",
                "-DWITH_JPEG=ON",
                "-DWITH_PNG=ON",
                "-DWITH_TIFF=OFF",
                "-DWITH_WEBP=OFF",
                "-DWITH_OPENJPEG=OFF",
                "-DWITH_JASPER=OFF",
                "-DWITH_OPENEXR=OFF",
                "-DWITH_AVIF=OFF",
                "-DWITH_JPEGXL=OFF",
                "-DWITH_IMGCODEC_HDR=OFF",
                "-DWITH_IMGCODEC_SUNRASTER=OFF",
                "-DWITH_IMGCODEC_PXM=OFF",
                "-DWITH_IMGCODEC_PFM=OFF",
                "-DWITH_IPP=OFF",
                "-DBUILD_IPP_IW=OFF",
                "-DWITH_ITT=OFF",
                "-DWITH_ADE=OFF",
                "-DWITH_OPENCL=OFF",
                "-DWITH_OPENGL=OFF",
                "-DWITH_CUDA=OFF",
                "-DWITH_VA=OFF",
                "-DWITH_VA_INTEL=OFF",
                "-DWITH_EIGEN=OFF",
                "-DWITH_LAPACK=OFF",
                "-DWITH_PROTOBUF=OFF",
                "-DWITH_FLATBUFFERS=OFF",
                "-DWITH_QUIRC=OFF",
                "-DWITH_FFMPEG=OFF",
                "-DWITH_GSTREAMER=OFF",
                "-DWITH_V4L=OFF",
                "-DWITH_1394=OFF",
                "-DWITH_GPHOTO2=OFF",
                "-DWITH_GTK=OFF",
                "-DWITH_QT=OFF",
                "-DWITH_VTK=OFF",
                "-DWITH_OBSENSOR=OFF",
                "-DOPENCV_GENERATE_PKGCONFIG=OFF",
                "-DOPENCV_SKIP_PYTHON_LOADER=ON",
                "-DINSTALL_PYTHON_EXAMPLES=OFF",
                "-DPYTHON3_EXECUTABLE=/usr/bin/python3",
                "-DOPENCV_PYTHON3_INSTALL_PATH=lib/python3.14/site-packages"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/opencv/opencv/archive/refs/tags/4.14.0.tar.gz",
                    "sha256": "ee8fb9b30eb60850431b4656447080e3737b56e45719c92b67f245950609f86e"
                }
            ],
            "cleanup": [
                "/bin",
                "/share/opencv4",
                "/share/licenses"
            ]
        },
        {
            "name": "photoscanner",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "../.."
                }
            ]
        }
    ]
}
