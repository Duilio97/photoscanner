#: data/app.desktop.in.in:2 data/app.metainfo.xml.in.in:7
#: src/photoscanner/main.py:44 src/photoscanner/window.py:57
msgid "Photo Scanner"
msgstr "Photo Scanner"

#: data/app.desktop.in.in:3 data/app.metainfo.xml.in.in:8
msgid "Turn photos of documents into scans"
msgstr "Trasforma le foto di documenti in scansioni"

#. TRANSLATORS: search terms, separated by ";" and ending with ";"
#: data/app.desktop.in.in:5
msgid "scanner;scan;document;pdf;photo;receipt;paper;"
msgstr "scanner;scansione;scansionare;documento;pdf;foto;ricevuta;scontrino;foglio;"

#: data/app.metainfo.xml.in.in:10
msgid ""
"Photo Scanner turns photos of documents, receipts and notes taken with a "
"phone into clean, straight scans and PDF files."
msgstr "Photo Scanner trasforma le foto di documenti, ricevute e appunti scattate con il telefono in scansioni pulite e diritte e in file PDF."

#: data/app.metainfo.xml.in.in:15
msgid ""
"Finds the sheet of paper automatically, even on a table of a similar color"
msgstr "Trova il foglio da solo, anche su un tavolo di colore simile"

#: data/app.metainfo.xml.in.in:16
msgid ""
"Corners and sides can be adjusted by hand, with a magnifier for precision"
msgstr "Angoli e lati si possono sistemare a mano, con una lente per essere precisi"

#: data/app.metainfo.xml.in.in:17
msgid "Removes shadows and uneven lighting"
msgstr "Toglie le ombre e la luce non uniforme"

#: data/app.metainfo.xml.in.in:18
msgid "Enhanced color, grayscale and black and white filters"
msgstr "Filtri colore migliorato, scala di grigi e bianco e nero"

#: data/app.metainfo.xml.in.in:19
msgid "Rotate and reorder pages, then export a multi-page PDF or images"
msgstr "Ruota e riordina le pagine, poi esporta un PDF di più pagine o delle immagini"

#: data/app.metainfo.xml.in.in:20
msgid "Opens JPEG, PNG, HEIC, WebP, AVIF, JPEG XL and more"
msgstr "Apre JPEG, PNG, HEIC, WebP, AVIF, JPEG XL e altri formati"

#: data/app.metainfo.xml.in.in:22
msgid "Everything happens on your computer: no account and no cloud."
msgstr "Tutto avviene sul tuo computer: niente account e niente cloud."

#: data/app.metainfo.xml.in.in:38
msgid "Adjusting the corners of the sheet"
msgstr "Sistemare gli angoli del foglio"

#: data/app.metainfo.xml.in.in:42
msgid "A magnifier helps to place the corners precisely"
msgstr "Una lente aiuta a posizionare gli angoli con precisione"

#: data/app.metainfo.xml.in.in:46
msgid "The finished scan, ready to be exported"
msgstr "La scansione finita, pronta da esportare"

#: data/app.metainfo.xml.in.in:50
msgid "Drop photos to start"
msgstr "Trascina le foto per cominciare"

#: data/app.metainfo.xml.in.in:69
msgid "First release."
msgstr "Prima versione."

#: src/photoscanner/main.py:50
msgid "Turn photos of documents into clean scans and PDF files"
msgstr "Trasforma le foto di documenti in scansioni pulite e in file PDF"

